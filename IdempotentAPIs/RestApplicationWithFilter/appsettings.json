{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IdempotentOptions": {
    "HeaderName": "X-Idempotency-Key",
    "CacheDurationInMinutes": 60,
    "RedisNodes": [
      "localhost:6379",
      "localhost:6380",
      "localhost:6381"
    ]
  }

}
