{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=CommerceDb;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True;"
  },
  "IdempotentOptions": {
    "HeaderName": "X-Idempotency-Key",
    "CacheDurationInMinutes": 60,
    "RedisNodes": [
      "localhost:6379",
      "localhost:6380",
      "localhost:6381"
    ]
  },
  "MessageBrokerOptions": {
    "Endpoints": [
      {
        "HostName": "localhost",
        "Port": 5672
      }
    ],
    "UserName": "guest",
    "Password": "guest",
    "PollingIntervalInSeconds": 2,
    "MaxRetryThreshold": 3, // Number of background publishing retries before writing an error state to SQL
    // --- New Configurable Connection Retry Strategies ---
    "RetryStrategy": "Exponential", // Options: "Fixed" or "Exponential"
    "InitialRetryDelayInSeconds": 2, // Starting wait duration (Base)
    "MaxRetryDelayInSeconds": 60, // Ceiling limit to prevent infinitely long pauses
    "Source": {
    },
    "Target": {
      "Type": "Queue", // Options: "Queue" or "Exchange"
      "Name": "orders.placed" // The worker forwards or broadcasts to here
    }
  }
}
